# --- WhatsApp Cloud API (developers.facebook.com > your app > WhatsApp > API Setup) ---
WA_TOKEN=                      # temporary access token (24h) or system-user token
WA_PHONE_NUMBER_ID=            # the test number's phone_number_id
WA_VERIFY_TOKEN=parakh-verify  # any string; must match what you enter in webhook config

# --- Anthropic (L2 paraphrase->rule mapping, OCR assist) ---
ANTHROPIC_API_KEY=

# --- App ---
DATABASE_PATH=data/parakh.db
BASE_URL=http://localhost:8000
CAMPAIGN_THRESHOLD=3           # same-hash sightings within window -> campaign
CAMPAIGN_WINDOW_HOURS=24
